{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event Packet (E-PKT)",
  "type": "object",
  "required": [
    "id",
    "ts",
    "nonce",
    "type"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "ts": {
      "type": "string",
      "format": "date-time"
    },
    "nonce": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "type": {
      "type": "string",
      "maxLength": 64
    },
    "channel": {
      "type": "string",
      "maxLength": 32
    }
  }
}
