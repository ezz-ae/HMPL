{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cologic.ezz.ae/schemas/hmp/c-pack/1.0.json",
  "title": "HMP Constraint Pack (C-PACK) v1.0",
  "type": "object",
  "required": [
    "version",
    "domain",
    "invariants",
    "forbidden",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "domain": {
      "type": "string",
      "enum": [
        "GENERIC",
        "GOV",
        "FINANCE",
        "HEALTH",
        "REAL_ESTATE",
        "SECURITY",
        "EDU",
        "LEGAL"
      ]
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/defs/rule"
      }
    },
    "forbidden": {
      "type": "array",
      "items": {
        "$ref": "#/defs/rule"
      }
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/defs/check"
      }
    }
  },
  "defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "label",
        "severity"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "label": {
          "type": "string",
          "maxLength": 256
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MED",
            "HIGH",
            "CRITICAL"
          ]
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "lang",
        "expr"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MED",
            "HIGH",
            "CRITICAL"
          ]
        },
        "lang": {
          "type": "string",
          "enum": [
            "CXL"
          ]
        },
        "when": {
          "type": "string",
          "maxLength": 2048
        },
        "expr": {
          "type": "string",
          "maxLength": 2048
        }
      }
    }
  }
}
