{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cologic.ezz.ae/schemas/hmp/h-prec/1.0.json",
  "title": "HMP Precedent Packet (H-PREC) v1.0",
  "type": "object",
  "required": [
    "precedent_id",
    "domain",
    "issued_at",
    "case_id",
    "decision_code",
    "facts",
    "signatures"
  ],
  "additionalProperties": false,
  "properties": {
    "precedent_id": {
      "type": "string",
      "maxLength": 128
    },
    "domain": {
      "type": "string",
      "enum": [
        "GENERIC",
        "GOV",
        "FINANCE",
        "HEALTH",
        "REAL_ESTATE",
        "SECURITY",
        "LEGAL",
        "EDU"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "case_id": {
      "type": "string",
      "maxLength": 128
    },
    "decision_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\.]{3,64}$"
    },
    "exception_code": {
      "type": "string",
      "pattern": "^[A-Z0-9_\\.]{3,64}$"
    },
    "facts": {
      "title": "H-PREC facts",
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "pattern": "^[a-z0-9_]{1,32}$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 160
          },
          {
            "type": "number"
          },
          {
            "type": "boolean"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "constraints_triggered": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 128
      }
    },
    "required_lane": {
      "type": "string",
      "enum": [
        "EXECUTE",
        "REFUSE",
        "ESCALATE"
      ]
    },
    "policy_delta": {
      "type": "object"
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/defs/sig"
      }
    }
  },
  "defs": {
    "sig": {
      "type": "object",
      "required": [
        "signer",
        "alg",
        "sig"
      ],
      "additionalProperties": false,
      "properties": {
        "signer": {
          "type": "string",
          "maxLength": 128
        },
        "alg": {
          "type": "string",
          "enum": [
            "ed25519",
            "p256",
            "secp256k1"
          ]
        },
        "sig": {
          "type": "string",
          "maxLength": 512
        }
      }
    }
  }
}
